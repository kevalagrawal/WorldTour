# LLM — OpenRouter free models only. The app will not switch to a paid model.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free

# Flights — Aviationstack free plan (personal / non-commercial, limited monthly quota)
AVIATIONSTACK_API_KEY=

# Places
GEOAPIFY_API_KEY=

# Routing
OSRM_BASE_URL=https://router.project-osrm.org

# Providers
FLIGHT_PROVIDER=aviationstack
HOTEL_PROVIDER=openrouter
WEATHER_PROVIDER=open_meteo
ROUTING_PROVIDER=osrm
PLACES_PROVIDER=geoapify
CURRENCY_PROVIDER=frankfurter

# Runtime
USE_MOCK_FALLBACK=true
DEBUG_MODE=false

MAX_RETRY_ATTEMPTS=2
MAX_REPLAN_ATTEMPTS=2

# Live Google Flights fares + Google Hotels rates (free plan: 250 searches/month) — https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# Chat translation (Hindi, Gujarati, Marathi) — MyMemory free API, no key needed: https://mymemory.translated.net/doc/spec.php
# Optional: an email address raises the free daily limit from about 5,000 to 50,000 words.
MYMEMORY_EMAIL=efree56@gmail.com