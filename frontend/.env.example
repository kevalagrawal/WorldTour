# WorldTour frontend — copy to .env for local development, and add the same names in
# Vercel → (frontend project) → Settings → Environment Variables for production.
# Everything here ends up in the browser, so it must only ever hold PUBLIC values. Never put secret keys here.

# The AI planner (the ai/ Vercel project), no trailing slash.
# Leave empty for local development: Vite forwards /api to http://127.0.0.1:8000.
VITE_API_URL=

# The accounts server (the server/ Vercel project), no trailing slash, e.g. https://worldtour-server.vercel.app
# Local development: http://localhost:5000
VITE_SERVER_URL=

# Clerk → your application → API keys → Publishable key (starts with pk_). Public by design.
# Without this and VITE_SERVER_URL the site runs guest-only: planning works, sign-in is hidden.
VITE_CLERK_PUBLISHABLE_KEY=
