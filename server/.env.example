# WorldTour accounts API — a TEMPLATE. This file is committed to git and is public:
# keep every secret value below EMPTY. Put real values only in server/.env (git-ignored)
# and in Vercel → (server project) → Settings → Environment Variables.

# Local port for `npm run dev`
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers. Add the database name before the "?":
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/worldtour?retryWrites=true&w=majority
# Atlas → Network Access must allow 0.0.0.0/0 (Vercel's addresses change).
MONGODB_URI=

# Clerk → your application → Configure → API keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → endpoint https://<this-server>/api/webhooks/clerk
#   events: user.created, user.updated, user.deleted → its "Signing secret" (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudinary → Settings → API Keys. The key must be allowed to upload (create) images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=worldtour/avatars

# The website(s) allowed to call this API, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://worldtour-xi.vercel.app,http://localhost:5173,http://localhost:4173
# Public address of the website, used to build share links.
APP_URL=https://worldtour-xi.vercel.app
