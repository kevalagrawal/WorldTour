# WorldTour accounts API — copy to .env (local) or add each one in Vercel → Settings → Environment Variables.
# Never commit real values.

# Local port for `npm run dev`
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers. Put the database name before the "?":
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/worldtour?retryWrites=true&w=majority
# Atlas → Network Access must allow 0.0.0.0/0 (Vercel's addresses change).
MONGODB_URI=mongodb+srv://efree561:wOenngG3EGowANbY@cluster0.g98bv.mongodb.net/bankify?retryWrites=true&w=majority&appName=Cluster0

# Clerk → your application → Configure → API keys
CLERK_PUBLISHABLE_KEY=pk_test_ZW5vdWdoLXBpcmFuaGEtNzQ2NC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_bliPXYE6vKYuSzWq6kDz0xN5LjkFKHfA3Fd4tv4Ne3
# Clerk → Webhooks → Add endpoint https://<this-server>/api/webhooks/clerk
#   events: user.created, user.updated, user.deleted → copy its "Signing secret" (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudinary → Dashboard (Product environment credentials)
CLOUDINARY_CLOUD_NAME=dla3fgyyy
CLOUDINARY_API_KEY=236627143194251
CLOUDINARY_API_SECRET=ght3fWF7-rhQ3rTd_DTiWLFaG1Q
CLOUDINARY_FOLDER=worldtour/avatars

# The website(s) allowed to call this API, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://worldtour-xi.vercel.app,http://localhost:5173,http://localhost:4173
# Public address of the website, used to build share links.
APP_URL=https://worldtour-xi.vercel.app
